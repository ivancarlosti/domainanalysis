# Web Server & Reverse Proxy
# Port exposed to the Docker host machine
PORT=8080
# If you are using a reverse proxy (like Nginx), you can define the domain name here
DOMAIN=domainanalysis.example.com

# Authentication method (none, account, keycloak)
AUTH_METHOD=none

# Account auth settings
ACCOUNT_LOGIN=
ACCOUNT_PASSWORD=
RECAPTCHA_CLIENTID=
RECAPTCHA_CLIENTSECRET=

# Keycloak auth settings
# KEYCLOAK_REDIRECT_URI is the public base URL of this app; the server will append
# /api/auth/keycloak/callback to it and that's the URI you must register on Keycloak.
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=YOURSSORealm
KEYCLOAK_CLIENT_ID=domainanalysis
KEYCLOAK_CLIENT_SECRET=YOURKEYCLOAKCLIENTSECRET
KEYCLOAK_REDIRECT_URI=https://domainanalysis.example.com/
KEYCLOAK_EMAIL_ACCOUNT=youremail@example.com

# Cookie signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=
